# CoreSimRunner Configuration

# Network Settings
# Single address for core network (WebUI API, AMF/MME SCTP)
CORE_ADDRESS=192.168.55.53
WEBUI_PORT=5000

# PLMN Configuration (MCC + MNC combined)
# MCC is derived as PLMN[:3], MNC as PLMN[3:]
# e.g., PLMN=20893 → MCC=208, MNC=93
PLMN=20893

# IMSI Configuration
INITIAL_IMSI_INDEX=3

# Security Configuration (OPC/OP and Key)
PERMANENT_KEY="8baf473f2f8fd09487cccbd7097c6862"
OPC_VALUE="8e27b6af0e692e750f32667a3b14605d"
OP_VALUE=
AMF=8000

# Authentication Credentials
USERNAME=admin
PASSWORD=free5gc
API_TOKEN=admin

# Template Configuration (separate for each core network)
FREE5GC_SUBSCRIPTION_TEMPLATE=../config/free5gc_subscription_template.json
OPEN5GS_SUBSCRIPTION_TEMPLATE=../config/open5gs_subscription_template.json

# Default Values
DEFAULT_CORE_NETWORK=free5gc
DEFAULT_SUBSCRIPTION_COUNT=2

# 5G Configuration
GNB_ADDRESS=192.168.55.9
GNB_NR_CELL_ID=1
DNN=internet
SLICES={"SST": 1, "SD": "010203"}
ENABLE_IMS=false

# 4G Configuration
ENB_ADDRESS=192.168.55.9
MME_PORT=36412
ENB_ID=1
ENB_CELL_ID=1000000
TAC=000001
IMEISV=4370816125816151
APN=internet

# Logging
LOG_LEVEL=INFO
