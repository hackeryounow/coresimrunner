# CoreSimRunner Configuration Template
#
# Copy this file to `.env` in your working directory and adjust the
# values for your environment:
#     cp .env.example .env
#
# A `.env` in the current working directory always takes precedence
# over any bundled default.

# Network Settings
# Single address for core network (WebUI API, AMF/MME SCTP)
CORE_ADDRESS=192.168.100.11
WEBUI_PORT=9999

# PLMN Configuration (MCC + MNC combined)
# MCC is derived as PLMN[:3], MNC as PLMN[3:]
# e.g., PLMN=20893 → MCC=208, MNC=93
PLMN=46009

# IMSI Configuration
INITIAL_IMSI_INDEX=1

# Security Configuration (OPC/OP and Key)
PERMANENT_KEY = "12341234123412341234123412340000"
OPC_VALUE = "71a121bb69baf3c0cc53fb5038a0131f"
OP_VALUE=
AMF=8000

# Authentication Credentials
USERNAME=admin
PASSWORD=1423
API_TOKEN=admin

# Template Configuration (separate for each core network)
FREE5GC_SUBSCRIPTION_TEMPLATE=config/free5gc_subscription_template.json
OPEN5GS_SUBSCRIPTION_TEMPLATE=config/open5gs__subscription_template.json

# Default Values
DEFAULT_CORE_NETWORK=free5gc
DEFAULT_SUBSCRIPTION_COUNT=2

# 5G Configuration
GNB_ADDRESS=192.168.100.10
GNB_NR_CELL_ID=1
DNN=internet
# SLICES={"SST": 1, "SD": "010203"}
SLICES={"SST": 1}
ENABLE_IMS=true

# 4G Configuration
ENB_ADDRESS=192.168.55.9
MME_PORT=36412
ENB_ID=1
ENB_CELL_ID=1000000
TAC=000001
IMEISV=4370816125816151
APN=internet

# Logging
LOG_LEVEL=INFO

# VoNR IMS Configuration
UPF_IP=172.22.0.8
PCSCF_IP=172.22.0.21
PCSCF_PORT=5060
CALLER_PHONE=13012345679
CALLEE_PHONE=13012345678
